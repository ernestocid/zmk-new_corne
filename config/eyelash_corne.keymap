#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        tap_hold0: tap_hold0 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_HOLD0";
            bindings = <&mt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        word-back {
            bindings = <&mt LEFT_ALT LEFT>;
            key-positions = <17>;
            layers = <2>;
        };

        word-forward {
            bindings = <&mt LEFT_ALT RIGHT>;
            key-positions = <18>;
            layers = <2>;
        };

        beginning-line {
            bindings = <&mt LEFT_COMMAND LEFT>;
            key-positions = <4>;
            layers = <2>;
        };

        end-line {
            bindings = <&mt LEFT_COMMAND RIGHT>;
            key-positions = <5>;
            layers = <2>;
        };

        backspace-one-word {
            bindings = <&mt LEFT_ALT BACKSPACE>;
            key-positions = <14>;
            layers = <2>;
        };

        backspace-line {
            bindings = <&mt LEFT_COMMAND BACKSPACE>;
            key-positions = <1>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB                  &kp Q  &kp W  &kp E     &kp R  &kp T                                  &kp UP                &kp Y        &kp U          &kp I      &kp O    &kp P     &kp GRAVE
&tap_hold0 LCTRL ESCAPE  &kp A  &kp S  &kp D     &kp F  &kp G                        &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_ALT             &kp Z  &kp X  &kp C     &kp V  &kp B           &kp SPACE              &kp DOWN              &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                                       &kp LGUI  &mo 1  &kp LEFT_SHIFT                                               &lt 3 SPACE  &kp BACKSPACE  &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                                 &mmv MOVE_UP                     &kp CARET           &kp AMPERSAND  &kp ASTERISK  &kp N9        &kp N0         &kp TILDE
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp NUMBER_6        &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp PIPE
&trans  &trans           &trans        &kp PLUS      &kp EQUAL     &trans        &kp C_MUTE                    &mmv MOVE_DOWN                   &kp LS(UNDERSCORE)  &kp MINUS      &trans        &trans        &kp BACKSLASH  &trans
                                       &trans        &trans        &trans                                                                       &kp INS             &kp DEL        &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans         &trans                                 &mmv MOVE_UP                     &trans          &trans    &trans        &trans     &trans    &kp BSPC
&trans  &trans  &kp LS(LEFT_BRACKET)  &kp RIGHT_BRACKET      &trans         &trans                 &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans    &kp GRAVE
&trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PAGE_DOWN  &kp PAGE_UP  &trans                    &mmv MOVE_DOWN                   &trans          &trans    &trans        &trans     &kp PIPE  &kp TILDE
                                      &trans                 &trans         &kp SPACE                                                               &kp RET         &trans    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                  &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans      &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans          &sys_reset  &trans     &bootloader  &trans     &mkp MB5  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                       &trans       &trans     &trans                                                                   &trans       &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
