#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        tap_hold0: tap_hold0 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_HOLD0";
            bindings = <&mt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Left hand — top row

        left_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2 3>;   // Q W E
        };

        right_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <3 4 5>;   // E R T
        };

        // Left hand — home row

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <7 8 9>;   // A S D
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <9 10 11>; // D F G
        };

        // Left hand — bottom row

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <13 14 15>; // Z X C
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <15 16 17>; // C V B
        };

        // Right hand — top row

        dash {
            bindings = <&kp MINUS>;
            key-positions = <19 20 21>; // U I O
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <21 22 23>; // O P GRAVE
        };

        // Right hand — home row

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <25 26 27>; // J K L
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <27 28 29>; // L SEMI SQT
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB                  &kp Q  &kp W  &kp E     &kp R  &kp T             &kp Y        &kp U          &kp I      &kp O    &kp P     &kp GRAVE
&tap_hold0 LCTRL ESCAPE  &kp A  &kp S  &kp D     &kp F  &kp G             &kp H        &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_ALT             &kp Z  &kp X  &kp C     &kp V  &kp B             &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                                       &kp LGUI  &mo 1  &kp LEFT_SHIFT    &lt 3 SPACE  &kp BACKSPACE  &mo 2
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT     &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp N9        &kp N0         &kp TILDE
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp PIPE
&trans  &kp NUMBER_6     &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &trans        &trans         &trans        &trans        &kp BACKSLASH  &trans
                                       &trans        &trans        &trans          &kp INS       &kp DEL        &trans
            >;
        };

        raise_layer {
            display-name = "NAV";
            bindings = <
&trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &kp LG(LEFT_ARROW)  &kp LG(RIGHT)          &kp LG(LA(LEFT_ARROW))  &kp LG(LA(RIGHT_ARROW))  &trans        &kp LG(LEFT_BRACE)  &kp LG(RIGHT_BRACE)  &kp BSPC
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)    &kp LEFT_ARROW          &kp DOWN                 &kp UP_ARROW  &kp RIGHT           &trans               &kp GRAVE
&trans  &trans          &trans          &trans           &kp LG(BACKSPACE)   &kp LA(BACKSPACE)      &trans                  &trans                   &trans        &trans              &kp PIPE             &kp TILDE
                                        &trans           &trans              &kp SPACE              &kp RET                 &trans                   &trans
            >;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&bt BT_CLR_ALL  &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                  &kp F6          &kp F7                &kp F8             &kp F9  &kp F10          &kp F11
&bt BT_SEL 0    &kp LA(NUMBER_1)      &kp LA(NUMBER_2)      &kp LA(NUMBER_3)      &kp LA(NUMBER_4)      &kp LA(NUMBER_5)        &kp LG(K_MUTE)  &kp C_VOLUME_UP       &kp C_VOLUME_DOWN  &trans  &kp PRINTSCREEN  &kp F12
&bt BT_SEL 1    &kp LA(LS(NUMBER_1))  &kp LA(LS(NUMBER_2))  &kp LA(LS(NUMBER_3))  &kp LA(LS(NUMBER_4))  &kp LS(LA(NUMBER_5))    &kp LG(LS(A))   &kp LG(LS(NUMBER_5))  &trans             &trans  &trans           &bootloader
                                                            &trans                &trans                &trans                  &trans          &trans                &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
